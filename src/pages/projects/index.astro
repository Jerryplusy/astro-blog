---
import { Image } from 'astro:assets'

import { Collapse } from 'astro-theme/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'active-projects', text: 'Active Projects' },
  { depth: 2, slug: 'legacy-projects', text: 'Legacy Projects' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/Jerryplusy'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 id='active-projects'>Active Projects</h2>
  <ProjectSection
    projects={[
      {
        name: 'Mioku',
        description: 'Core development in progress for the Mioku ecosystem.',
        links: [
          { type: 'github', href: 'https://github.com/mioku-lab/mioku' }
        ]
      },
      {
        name: 'Mioki (Maintenance)',
        description: 'Participating in maintenance work for the mioki project.',
        links: [
          { type: 'github', href: 'https://github.com/vikiboss/mioki' }
        ]
      }
    ]}
  />

  <h2 id='legacy-projects'>Legacy Projects</h2>
  <Collapse title='Some old projects'>
    <ProjectSection
      projects={[
        {
          name: 'Crystelf-core',
          description: 'A simple, fast and powerful API framework.',
          links: [
            { type: 'github', href: 'https://github.com/crystelf/crystelf-core' },
            { type: 'doc', href: 'https://docs.crystelf.top/core' }
          ]
        },
        {
          name: 'Crystelf-plugin',
          description: 'Plugin collection and integrations for the Crystelf ecosystem.',
          links: [{ type: 'github', href: 'https://github.com/Jerryplusy/crystelf-plugin' }]
        }
      ]}
    />
  </Collapse>
</PageLayout>
